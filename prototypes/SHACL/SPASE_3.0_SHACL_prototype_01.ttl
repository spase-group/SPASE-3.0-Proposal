    ] .


spase:LicenseDocument_Shape
    a sh:NodeShape ;
    rdfs:label "License Document" ;
    sh:targetClass dcterms:LicenseDocument ;
    sh:property [
        sh:name "title" ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:path dcterms:title ;
        sh:severity sh:Violation
    ] .


spase:Concept_Shape
    a sh:NodeShape ;
    rdfs:label "Concept" ;
    sh:targetClass skos:Concept ;
    sh:severity sh:Violation ;
    sh:property [
        sh:name "preferred label" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:path skos:prefLabel ;
        sh:severity sh:Violation
    ] ;
    sh:not [
        sh:xone (
            [
                sh:property [
                    sh:name "notation" ;
                    sh:minCount 1 ;
                    sh:maxCount 1 ;
                    sh:datatype xsd:string ;
                    sh:path skos:notation
                ]
            ] 
            [
                sh:property [
                    sh:name "in scheme" ;
                    sh:minCount 1 ;
                    sh:maxCount 1 ;
                    sh:or (
                        [ 
                            sh:nodeKind sh:IRI ;
                            sh:or (
                                [ sh:class skos:ConceptScheme ] 
                                [ 
                                    sh:path rdf:type ;
                                    sh:maxCount 0
                                ]
                            )
                        ]
                        [ 
                            sh:nodeKind sh:BlankNode ;
                            sh:class skos:ConceptScheme
                        ]
                    ) ;
                    sh:path skos:inScheme
                ]
            ]
        )
    ] .


spase:ConceptScheme_Shape
    a sh:NodeShape ;
    rdfs:label "Concept Scheme" ;
    sh:targetClass skos:ConceptScheme ;
    sh:property [
        sh:name "title" ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:path dcterms:title ;
        sh:severity sh:Violation
    ] .


spase:OtherIdentifier_Shape
    a sh:NodeShape ;
    rdfs:label "Other Identifier" ;
    sh:targetClass adms:Identifier ;
    sh:severity sh:Violation ;
    sh:property [
        sh:name "notation" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:path skos:notation 
    ] ;
    sh:or (
        [
            sh:property [
                sh:name "creator" ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:or (
                    [ 
                        sh:nodeKind sh:IRI ;
                        sh:or (
                            [ sh:class foaf:Organization ] 
                            [ 
                                sh:path rdf:type ;
                                sh:maxCount 0
                            ]
                        )
                    ]
                    [ 
                        sh:nodeKind sh:BlankNode ;
                        sh:class foaf:Organization
                    ]
                ) ;
                sh:path ( dcterms:creator [ sh:zeroOrMorePath rdf:rest ] rdf:first )
            ]
        ] 
        [
            sh:property [
                sh:name "schema agency" ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:string ;
                sh:path adms:schemaAgency ;
                sh:severity sh:Violation
            ]
        ] 
    );
    sh:property [
        sh:name "version" ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:path dcat:version ;
        sh:severity sh:Violation
    ] .


spase:Role_Shape
    a sh:NodeShape ;
    rdfs:label "Role" ;
    sh:targetClass dcat:Role ;
    sh:severity sh:Violation ;
    sh:property [
        sh:name "preferred label" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:path skos:prefLabel ;
        sh:severity sh:Violation
    ] ;
    sh:not [
        sh:xone (
            [
                sh:property [
                    sh:name "notation" ;
