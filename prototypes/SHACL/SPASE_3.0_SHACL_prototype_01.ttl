                    sh:datatype xsd:string ;
                    sh:path skos:notation
                ]
            ] 
            [
                sh:property [
                    sh:name "in scheme" ;
                    sh:minCount 1 ;
                    sh:maxCount 1 ;
                    sh:or (
                        [ 
                            sh:nodeKind sh:IRI ;
                            sh:or (
                                [ sh:class skos:ConceptScheme ] 
                                [ 
                                    sh:path rdf:type ;
                                    sh:maxCount 0
                                ]
                            )
                        ]
                        [ 
                            sh:nodeKind sh:BlankNode ;
                            sh:class skos:ConceptScheme
                        ]
                    ) ;
                    sh:path skos:inScheme
                ]
            ]
        )
    ] .


spase:MonetaryGrant_Shape
    a sh:NodeShape ;
    rdfs:label "Monetary Grant" ;
    sh:targetClass schema:MonetaryGrant ;
    sh:property
        [
            sh:name "funder" ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:class foaf:Organization ;
            sh:path schema:funder ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "title" ;
            sh:maxCount 1 ;
            sh:datatype xsd:string ;
            sh:path dcterms:title ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "identifier" ;
            sh:datatype xsd:string ;
            sh:path dcterms:identifier ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "other identifier" ;
            sh:or (
                [ 
                    sh:nodeKind sh:IRI ;
                    sh:or (
                        [ sh:class adms:Identifier ] 
                        [ 
                            sh:path rdf:type ;
                            sh:maxCount 0
                        ]
                    )
                ]
                [ 
                    sh:nodeKind sh:BlankNode ;
                    sh:class adms:Identifier
                ]
            ) ;
            sh:path adms:identifier ;
            sh:severity sh:Violation
        ] .


spase:Quantity_Shape
    a sh:NodeShape ;
    rdfs:label "Quantity" ;
    sh:targetClass qudt:Quantity ;
    sh:property
        [
            sh:name "identifier" ;
            sh:datatype xsd:string ;
            sh:path dcterms:identifier ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "preferred label" ;
            sh:maxCount 1 ;
            sh:datatype xsd:string ;
            sh:path skos:prefLabel ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "description" ;
            sh:maxCount 1 ;
            sh:datatype xsd:string ;
            sh:path dcterms:description ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "order" ;
            sh:datatype xsd:integer ;
            sh:path qudt:order ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "unit" ;
            sh:or (
                [ 
                    sh:nodeKind sh:IRI ;
                    sh:or (
                        [ sh:class qudt:Unit ] 
                        [ 
                            sh:path rdf:type ;
                            sh:maxCount 0
                        ]
                    )
                ]
                [ 
                    sh:nodeKind sh:BlankNode ;
                    sh:class qudt:Unit
                ]
            ) ;
            sh:path qudt:hasUnit ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "quantity kind" ;
            sh:or (
                [ 
                    sh:nodeKind sh:IRI ;
                    sh:or (
                        [ sh:class qudt:QuantityKind ] 
                        [ 
                            sh:path rdf:type ;
                            sh:maxCount 0
                        ]
                    )
                ]
                [ 
                    sh:nodeKind sh:BlankNode ;
                    sh:class qudt:QuantityKind
                ]
            ) ;
            sh:path qudt:hasQuantityKind ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "quantity value" ;
            sh:or (
                [ 
                    sh:nodeKind sh:IRI ;
                    sh:or (
                        [ sh:class qudt:QuantityValue ] 
                        [ 
                            sh:path rdf:type ;
                            sh:maxCount 0
                        ]
                    )
                ]
                [ 
                    sh:nodeKind sh:BlankNode ;
                    sh:class qudt:QuantityValue
                ]
            ) ;
            sh:path qudt:quantityValue ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "coordinate system" ;
            sh:or (
                [ 
                    sh:nodeKind sh:IRI ;
                    sh:or (
                        [ sh:class skos:Concept ] 
                        [ 
                            sh:path rdf:type ;
                            sh:maxCount 0
                        ]
                    )
                ]
                [ 
                    sh:nodeKind sh:BlankNode ;
                    sh:class skos:Concept
                ]
            ) ;
            sh:path qudt:coordinateSystem ;
            sh:severity sh:Violation
        ] .


spase:QuantityValue_Shape
    a sh:NodeShape ;
    rdfs:label "Quantity Value" ;
    sh:targetClass qudt:QuantityValue ;
    sh:property
        [
            sh:name "value" ;
            sh:maxCount 1 ;
            sh:or ( [ sh:datatype xsd:double ] [ sh:datatype xsd:integer ] ) ;
            sh:path qudt:value ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "minimum inclusive" ;
            sh:maxCount 1 ;
            sh:or ( [ sh:datatype xsd:double ] [ sh:datatype xsd:integer ] ) ;
            sh:path qudt:minInclusive ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "maximum inclusive" ;
            sh:maxCount 1 ;
            sh:or ( [ sh:datatype xsd:double ] [ sh:datatype xsd:integer ] ) ;
            sh:path qudt:maxInclusive ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "unit" ;
            sh:minCount 1 ;
            sh:or (
                [ 
                    sh:nodeKind sh:IRI ;
                    sh:or (
                        [ sh:class qudt:Unit ] 
                        [ 
                            sh:path rdf:type ;
                            sh:maxCount 0
                        ]
                    )
                ]
                [ 
                    sh:nodeKind sh:BlankNode ;
                    sh:class qudt:Unit
                ]
            ) ;
            sh:path qudt:hasUnit ;
            sh:severity sh:Violation
        ] .


spase:Unit_Shape
    a sh:NodeShape ;
    rdfs:label "Unit" ;
    sh:targetClass qudt:Unit ;
    sh:severity sh:Violation ;
    sh:property [
        sh:name "exact match" ;
        sh:nodeKind sh:IRI ;
        sh:path skos:exactMatch ;
        sh:severity sh:Violation
    ] ;
    sh:or (
        [
            sh:property [
                    sh:name "preferred label" ;
                    sh:minCount 1 ;
                    sh:maxCount 1 ;
                    sh:datatype xsd:string ;
                    sh:path skos:prefLabel
                ] 
        ]
        [
            sh:property [
                sh:name "notation" ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:string ;
                sh:path skos:notation
            ]
        ] 
    ) ;
    sh:not [
            sh:xone (
                [
                    sh:property [
                        sh:name "notation" ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:datatype xsd:string ;
                        sh:path skos:notation
                    ]
                ] 
                [
                    sh:property [
                        sh:name "conforms to" ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:or (
                            [ 
                                sh:nodeKind sh:IRI ;
                                sh:or (
                                    [ sh:class dcterms:Standard ] 
                                    [ 
                                        sh:path rdf:type ;
                                        sh:maxCount 0
                                    ]
                                )
                            ]
                            [ 
                                sh:nodeKind sh:BlankNode ;
                                sh:class dcterms:Standard
                            ]
                        ) ;
                        sh:path dcterms:conformsTo
                    ]
                ]
            )
        ] .



spase:Standard_Shape
    a sh:NodeShape ;
    rdfs:label "Standard" ;
    sh:targetClass dcterms:Standard ;
    sh:property
        [
            sh:name "identifier" ;
            sh:datatype xsd:string ;
            sh:path dcterms:identifier ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "title" ;
            sh:minCount 1 ;
            sh:datatype xsd:string ;
            sh:path dcterms:title ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "version" ;
            sh:maxCount 1 ;
            sh:datatype xsd:string ;
            sh:path dcat:version ;
            sh:severity sh:Violation
        ] .



spase:PeriodOfTime_Shape
    a sh:NodeShape ;
    rdfs:label "Period Of Time" ;
    sh:targetClass dcterms:PeriodOfTime ;
    sh:property
        [
            sh:name "start date" ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:datatype xsd:dateTime ;
            sh:path dcat:startDate ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "end date" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:datatype xsd:dateTime ;
            sh:path dcat:endDate ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "relative end date" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:datatype xsd:duration ;
            sh:path spase:relativeEndDate ;
            sh:severity sh:Violation
        ]  .



spase:Location_Shape
    a sh:NodeShape ;
    rdfs:label "Location" ;
    sh:targetClass dcterms:Location ;
    sh:property
        [
            sh:name "centroid" ;
            sh:datatype geo:wktLiteral ;
            sh:path dcat:centroid ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "bounding box" ;
            sh:datatype geo:wktLiteral ;
            sh:path dcat:bbox ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "geometry" ;
            sh:datatype geo:wktLiteral ;
            sh:path locn:geometry ;
            sh:severity sh:Violation
        ]  .


spase:Coordinates_Shape
    a sh:NodeShape ;
    rdfs:label "Coordinates" ;
    sh:targetClass qudt:Coordinates ;
    sh:property
        [
            sh:name "element" ;
            sh:or (
                [ 
                    sh:nodeKind sh:IRI ;
                    sh:or (
                        [ sh:class qudt:Quantity ] 
                        [ 
                            sh:path rdf:type ;
                            sh:maxCount 0
                        ]
                    )
                ]
                [ 
                    sh:nodeKind sh:BlankNode ;
                    sh:class qudt:Quantity
                ]
            ) ;
            sh:path ( qudt:element [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "coordinate system" ;
            sh:minCount 1 ;
            sh:or (
                [ 
                    sh:nodeKind sh:IRI ;
                    sh:or (
                        [ sh:class skos:Concept ] 
                        [ 
                            sh:path rdf:type ;
                            sh:maxCount 0
                        ]
                    )
                ]
                [ 
                    sh:nodeKind sh:BlankNode ;
                    sh:class skos:Concept
                ]
            ) ;
            sh:path qudt:coordinateSystem ;
            sh:severity sh:Violation
        ] .


spase:Distribution_Shape
    a sh:NodeShape ;
    rdfs:label "Distribution" ;
    sh:targetClass dcat:Distribution ;
    sh:or (
        [
            sh:name "access URL" ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dcat:accessURL ;
            sh:severity sh:Violation
        ]
        [
            sh:minCount 1 ;
            sh:name "access service" ;
            sh:nodeKind sh:BlankNodeOrIRI;
            sh:class dcat:DataService ;
            sh:path dcat:accessService ;
            sh:severity sh:Violation
        ]
    ) ;
    sh:property
        [
            sh:name "title" ;
            sh:datatype xsd:string ;
            sh:path dcterms:title ;
            sh:severity sh:Violation
        ] ,
        [
            sh:maxCount 1 ;
            sh:name "access rights" ;
            sh:or (
                [ 
                    sh:nodeKind sh:IRI ;
                    sh:or (
                        [ sh:class dcterms:RightsStatement ] 
                        [ 
                            sh:path rdf:type ;
                            sh:maxCount 0
                        ]
                    )
                ]
                [ 
                    sh:nodeKind sh:BlankNode ;
                    sh:class dcterms:RightsStatement
                ]
            ) ;
            sh:path dcterms:accessRights ;
            sh:severity sh:Violation
        ] ,
        [
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:name "license" ;
            sh:or (
                [ 
                    sh:nodeKind sh:IRI ;
                    sh:or (
                        [ sh:class dcterms:LicenseDocument ] 
                        [ 
                            sh:path rdf:type ;
                            sh:maxCount 0
                        ]
                    )
                ]
                [ 
                    sh:nodeKind sh:BlankNode ;
                    sh:class dcterms:LicenseDocument
                ]
            ) ;
            sh:path dcterms:license ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "format" ;
            sh:or (
                [ 
                    sh:nodeKind sh:IRI ;
                    sh:or (
                        [ sh:class skos:Concept ] 
                        [ 
                            sh:path rdf:type ;
                            sh:maxCount 0
                        ]
                    )
                ]
                [ 
                    sh:nodeKind sh:BlankNode ;
                    sh:class skos:Concept
                ]
            ) ;
            sh:path dcterms:format ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "conforms to" ;
            sh:or (
                [ 
                    sh:nodeKind sh:IRI ;
                    sh:or (
                        [ sh:class dcterms:Standard ] 
                        [ 
                            sh:path rdf:type ;
                            sh:maxCount 0
                        ]
                    )
                ]
                [ 
                    sh:nodeKind sh:BlankNode ;
                    sh:class dcterms:Standard
                ]
            ) ;
            sh:path dcterms:conformsTo ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "byte size" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dcat:byteSize ;
            sh:severity sh:Violation
        ] .


spase:DataService_Shape
    a sh:NodeShape ;
    rdfs:label "Data Service" ;
    sh:targetClass dcat:DataService ;
    sh:property
        [
            sh:name "title" ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:datatype xsd:string ;
            sh:path dcterms:title ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "description" ;
            sh:maxCount 1 ;
            sh:datatype xsd:string ;
            sh:path dcterms:description ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "type" ;
            sh:maxCount 1 ;
            sh:or (
                [ 
                    sh:nodeKind sh:IRI ;
                    sh:or (
                        [ sh:class skos:Concept ] 
                        [ 
                            sh:path rdf:type ;
                            sh:maxCount 0
                        ]
                    )
                ]
                [ 
                    sh:nodeKind sh:BlankNode ;
                    sh:class skos:Concept
                ]
            ) ;
            sh:path dcterms:type ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "identifier" ;
            sh:datatype xsd:string ;
            sh:path dcterms:identifier ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "other identifier" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:class adms:Identifier ;
            sh:path adms:identifier ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "conforms to" ;
            sh:or (
                [ 
                    sh:nodeKind sh:IRI ;
                    sh:or (
                        [ sh:class dcterms:Standard ] 
                        [ 
                            sh:path rdf:type ;
                            sh:maxCount 0
                        ]
                    )
                ]
                [ 
                    sh:nodeKind sh:BlankNode ;
                    sh:class dcterms:Standard
                ]
            ) ;
            sh:path dcterms:conformsTo ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "contact point" ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI;
            sh:class vcard:Kind ;
            sh:path dcat:contactPoint ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "serves dataset" ;
            sh:node [
                a sh:NodeShape ;
                sh:class dcat:Dataset ;
                sh:property [
                    sh:path dcterms:identifier ;
                    sh:minCount 1 
                ] 
            ] ;
            sh:path dcat:servesDataset ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "endpoint URL" ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path dcat:endpointURL ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "endpoint description" ;
            sh:nodeKind sh:IRI ;
            sh:path dcat:endpointDescription ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "publisher" ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:or (
                [ 
                    sh:nodeKind sh:IRI ;
                    sh:or (
                        [ sh:class foaf:Organization ] 
                        [ 
                            sh:path rdf:type ;
                            sh:maxCount 0
                        ]
                    )
                ]
                [ 
                    sh:nodeKind sh:BlankNode ;
                    sh:class foaf:Organization
                ]
            ) ;
            sh:path dcterms:publisher ;
            sh:severity sh:Violation
        ] .


spase:Relationship_Shape
    a sh:NodeShape ;
    rdfs:label "Relationship" ;
    sh:targetClass dcat:Relationship ;
    sh:property
        [
            sh:name "relation" ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:path dcterms:relation ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "role" ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:or (
                [ 
                    sh:nodeKind sh:IRI ;
                    sh:or (
                        [ sh:class dcat:Role ] 
                        [ 
                            sh:path rdf:type ;
                            sh:maxCount 0
                        ]
                    )
                ]
                [ 
                    sh:nodeKind sh:BlankNode ;
                    sh:class dcat:Role
                ]
            ) ;
            sh:path dcat:hadRole ;
            sh:severity sh:Violation
        ] .



spase:Execution_Shape
    a sh:NodeShape ;
    rdfs:label "Execution" ;
    sh:targetClass provone:Execution ;
    sh:property
        [
            sh:name "plan" ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:or (
                [ 
                    sh:nodeKind sh:IRI ;
                    sh:or (
                        [ sh:class prov:Plan ] 
                        [ 
                            sh:path rdf:type ;
                            sh:maxCount 0
                        ]
                    )
                ]
                [ 
                    sh:nodeKind sh:BlankNode ;
                    sh:class prov:Plan
                ]
            ) ;
            sh:path prov:hadPlan ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "used" ;
            sh:or (
                [ 
                    sh:nodeKind sh:IRI ;
                    sh:or (
                        [ sh:class prov:Entity ] 
                        [ 
                            sh:path rdf:type ;
                            sh:maxCount 0
                        ]
                    )
                ]
                [ 
                    sh:nodeKind sh:BlankNode ;
                    sh:class prov:Entity
                ]
            ) ;
            sh:path prov:used ;
            sh:severity sh:Violation
        ] .










spase:ObservationCollection_Shape
    a sh:NodeShape ;
    rdfs:label "ObservationCollection" ;
    sh:targetClass sosa:ObservationCollection;
    sh:property
        [
            sh:name "made by sensor" ;
            sh:or (
                [ 
                    sh:nodeKind sh:IRI ;
                    sh:or (
                        [ sh:class sosa:Sensor ] 
                        [ 
                            sh:path rdf:type ;
                            sh:maxCount 0
                        ]
                    )
                ]
                [ 
                    sh:nodeKind sh:BlankNode ;
                    sh:class sosa:Sensor
                ]
            ) ;
            sh:path sosa:madeBySensor ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "has member" ;
            sh:or (
                [ 
                    sh:nodeKind sh:IRI ;
                    sh:or (
                        [ sh:class sosa:Observation ] 
                        [ 
                            sh:path rdf:type ;
                            sh:maxCount 0
                        ]
                    )
                ]
                [ 
                    sh:nodeKind sh:BlankNode ;
                    sh:class sosa:Observation
                ]
            ) ;
            sh:path ( sosa:hasMember [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
            sh:severity sh:Violation
        ] .



spase:Observation_Shape
    a sh:NodeShape ;
    rdfs:label "Observation" ;
    sh:targetClass sosa:Observation;
    sh:property
        [
            sh:name "made by sensor" ;
            sh:or (
                [ 
                    sh:nodeKind sh:IRI ;
                    sh:or (
                        [ sh:class sosa:Sensor ] 
                        [ 
                            sh:path rdf:type ;
                            sh:maxCount 0
                        ]
                    )
                ]
                [ 
                    sh:nodeKind sh:BlankNode ;
                    sh:class sosa:Sensor
                ]
            ) ;
            sh:path sosa:madeBySensor ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "observed property" ;
            sh:or (
                [ 
                    sh:nodeKind sh:IRI ;
                    sh:or (
                        [ sh:and ( [sh:class sosa:Property] [sh:class iop:Variable] ) ] 
                        [ 
                            sh:path rdf:type ;
                            sh:maxCount 0
                        ]
                    )
                ]
                [ 
                    sh:nodeKind sh:BlankNode ;
                    sh:and ( [sh:class sosa:Property] [sh:class iop:Variable] )
                ]
            ) ;
            sh:path sosa:observedProperty ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "has result" ;
            sh:or (
                [ 
                    sh:nodeKind sh:IRI ;
                    sh:or (
                        [ sh:class qudt:Quantity ] 
                        [ 
                            sh:path rdf:type ;
                            sh:maxCount 0
                        ]
                    )
                ]
                [ 
                    sh:nodeKind sh:BlankNode ;
                    sh:class qudt:Quantity
                ]
            ) ;
            sh:path sosa:hasResult ;
            sh:severity sh:Violation
        ] .



spase:Sensor_Shape
    a sh:NodeShape ;
    rdfs:label "Sensor" ;
    sh:targetClass sosa:Sensor ;
    sh:property
        [
            sh:name "title" ;
            sh:maxCount 1 ;
            sh:datatype xsd:string ;
            sh:path dcterms:title ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "identifier" ;
            sh:datatype xsd:string ;
            sh:path dcterms:identifier ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "other identifier" ;
            sh:or (
                [ 
                    sh:nodeKind sh:IRI ;
                    sh:or (
                        [ sh:class adms:Identifier ] 
                        [ 
                            sh:path rdf:type ;
                            sh:maxCount 0
                        ]
                    )
                ]
                [ 
                    sh:nodeKind sh:BlankNode ;
                    sh:class adms:Identifier
                ]
            ) ;
            sh:path adms:identifier ;
            sh:severity sh:Violation
        ] .



spase:Variable_Shape
    a sh:NodeShape ;
    rdfs:label "Variable" ;
    sh:targetClass iop:Variable;
    sh:property
        [
            sh:name "object of interest" ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:or (
                [ 
                    sh:nodeKind sh:IRI ;
                    sh:or (
                        [ sh:class iop:Entity ] 
                        [ 
                            sh:path rdf:type ;
                            sh:maxCount 0
                        ]
                    )
                ]
                [ 
                    sh:nodeKind sh:BlankNode ;
                    sh:class iop:Entity
                ]
            ) ;
            sh:path iop:hasObjectOfInterest ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "property" ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:or (
                [ 
                    sh:nodeKind sh:IRI ;
                    sh:or (
                        [ sh:class iop:Property ] 
                        [ 
                            sh:path rdf:type ;
                            sh:maxCount 0
                        ]
                    )
                ]
                [ 
                    sh:nodeKind sh:BlankNode ;
                    sh:class iop:Property
                ]
            ) ;
            sh:path iop:hasProperty ;
            sh:severity sh:Violation
        ] ,
        [
            sh:name "constraint" ;
            sh:or (
                [ 
                    sh:nodeKind sh:IRI ;
                    sh:or (
                        [ sh:class iop:Constraint ] 
                        [ 
                            sh:path rdf:type ;
                            sh:maxCount 0
                        ]
                    )
                ]
                [ 
                    sh:nodeKind sh:BlankNode ;
                    sh:class iop:Constraint
                ]
            ) ;
            sh:path iop:hasConstraint ;
            sh:severity sh:Violation
        ] .


spase:Constraint_Shape
    a sh:NodeShape ;
    rdfs:label "Constraint" ;
    sh:targetClass iop:Constraint;
    sh:property [
        sh:name "constrains" ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:path iop:constrains ;
        sh:severity sh:Violation
    ] .


spase:Array_Shape
    a sh:NodeShape ;
    rdfs:label "Array" ;
    sh:targetClass qudt:Array ;
    sh:property
        [
            sh:name "dimensionality" ;
            sh:datatype xsd:integer ;
            sh:path qudt:dimensionality ;
            sh:severity sh:Violation
        ],
        [
            sh:name "dimensions" ;
            sh:datatype xsd:integer ;
            sh:path ( qudt:dimensions [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
            sh:severity sh:Violation
        ],
        [
            sh:name "data order" ;
            sh:nodeKind sh:IRI ;
            sh:path qudt:dataOrder ;
            sh:severity sh:Violation
        ] .
